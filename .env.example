# Public site identity (no secrets in Phase 1)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Configure a newsletter provider before enabling subscriptions in a later phase.
# NEWSLETTER_PROVIDER=
# NEWSLETTER_API_KEY=

# DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/nocturne_studio?schema=public"

# AUTH.JS
# Generate one with: npx auth secret
AUTH_SECRET="your-secret-key-here"

# EMAIL (For future use in Password Reset)
# EMAIL_SERVER_HOST=
# EMAIL_SERVER_PORT=
# EMAIL_SERVER_USER=
# EMAIL_SERVER_PASSWORD=
# EMAIL_FROM=
